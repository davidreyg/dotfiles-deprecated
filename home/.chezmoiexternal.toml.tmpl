{{- $target := "" -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- if eq .chezmoi.arch "amd64" -}}{{ $target = "linux_amd64" }}{{ end -}}
  {{- if eq .chezmoi.arch "arm64" -}}{{ $target = "linux_arm64" }}{{ end -}}
{{- else if eq .chezmoi.os "darwin" -}}
  {{- if eq .chezmoi.arch "amd64" -}}{{ $target = "darwin_amd64" }}{{ end -}}
  {{- if eq .chezmoi.arch "arm64" -}}{{ $target = "darwin_arm64" }}{{ end -}}
{{- end -}}
{{- if and .external.enabled $target -}}
{{- range $name, $binary := .external.binaries -}}
  {{- if $binary.enabled -}}
    {{- with (index $binary.targets $target) }}
[".local/bin/{{ $name }}"]
    type = "archive-file"
    url = "{{ .url }}"
    path = "{{ .path }}"
    executable = true
    refreshPeriod = "168h"
    {{- end }}
  {{- end }}
{{- end }}
{{- end }}
