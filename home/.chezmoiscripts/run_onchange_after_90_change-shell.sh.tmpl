#!/bin/sh

set -eu

{{- $changeDefault := false -}}
{{- if hasKey . "shell" -}}
{{- $changeDefault = default false .shell.change_default -}}
{{- end -}}
{{- if not $changeDefault }}
exit 0
{{- end }}

zsh_path=$(command -v zsh || true)
if [ -z "$zsh_path" ]; then
    printf '%s\n' 'Cannot change the default shell: zsh is not installed.' >&2
    exit 1
fi

if [ ! -r /etc/shells ] || ! grep -Fxq "$zsh_path" /etc/shells; then
    printf 'Cannot change the default shell: %s is not listed in /etc/shells.\n' "$zsh_path" >&2
    exit 1
fi

current_shell=$(getent passwd "${USER:-$(id -un)}" 2>/dev/null | cut -d: -f7 || true)
if [ "$current_shell" = "$zsh_path" ]; then
    exit 0
fi

if ! command -v chsh >/dev/null 2>&1; then
    printf '%s\n' 'Cannot change the default shell: chsh is unavailable.' >&2
    exit 1
fi

chsh -s "$zsh_path"
