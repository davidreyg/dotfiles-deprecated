#!/bin/sh

set -eu

# mise is rendered after externals and configuration, so the first apply can
# install tools and generate completions.
mise="$HOME/.local/bin/mise"
if [ ! -x "$mise" ]; then
    mise=$(command -v mise || true)
fi

if [ -z "$mise" ]; then
    printf '%s\n' 'mise is not available; skipping Zsh completion installation.' >&2
    exit 0
fi

PATH="$HOME/.local/share/mise/shims:$HOME/.local/share/mise/bin:$HOME/.local/bin:$PATH"
export PATH

"$mise" install
"$mise" completion zsh --install
