#!/bin/sh

set -eu

{{ $profiles := list "base" "shell" }}
{{ if hasKey . "profiles" }}{{ $profiles = .profiles }}{{ end }}

package_installed() {
    manager=$1
    package=$2

    case "$manager" in
        apt-get) dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fxq 'install ok installed' ;;
        dnf|zypper) rpm -q "$package" >/dev/null 2>&1 ;;
        pacman) pacman -Q "$package" >/dev/null 2>&1 ;;
        apk) apk info -e "$package" >/dev/null 2>&1 ;;
        brew) brew list --formula "$package" >/dev/null 2>&1 ;;
        brew-cask) brew list --cask "$package" >/dev/null 2>&1 ;;
        *) return 1 ;;
    esac
}

if [ "$(uname -s)" = Darwin ]; then
    manager=brew
elif [ "$(uname -s)" = Linux ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    case "${ID:-}:${ID_LIKE:-}" in
        ubuntu:*|debian:*|*:*debian*) manager=apt-get ;;
        fedora:*|rhel:*|centos:*|*:*fedora*|*:*rhel*) manager=dnf ;;
        arch:*|manjaro:*|*:*arch*) manager=pacman ;;
        opensuse*:*|sles:*|*:*suse*) manager=zypper ;;
        alpine:*|*:*alpine*) manager=apk ;;
        *) printf 'Unsupported Linux distribution: %s\n' "${ID:-unknown}" >&2; exit 1 ;;
    esac
else
    printf 'Unsupported operating system: %s\n' "$(uname -s)" >&2
    exit 1
fi

missing=
missing_casks=
{{- range $groupName, $group := .packages.groups }}
{{- if has $groupName $profiles }}
{{- range $name, $package := $group.packages }}
{{- $default := $name }}
{{- if eq $name "jetbrains-mono-nerd-font" }}{{ $default = "" }}{{ end }}
{{- if not (hasKey $package "skip") }}
case "$manager" in
    apt-get) package_name="{{ $default }}"{{ if hasKey $package "apt" }}; package_name="{{ $package.apt }}"{{ end }} ;;
    dnf) package_name="{{ $default }}"{{ if hasKey $package "dnf" }}; package_name="{{ $package.dnf }}"{{ end }} ;;
    pacman) package_name="{{ $default }}"{{ if hasKey $package "pacman" }}; package_name="{{ $package.pacman }}"{{ end }} ;;
    zypper) package_name="{{ $default }}"{{ if hasKey $package "zypper" }}; package_name="{{ $package.zypper }}"{{ end }} ;;
    apk) package_name="{{ $default }}"{{ if hasKey $package "apk" }}; package_name="{{ $package.apk }}"{{ end }} ;;
    brew) package_name="{{ $default }}"{{ if hasKey $package "brew" }}; package_name="{{ $package.brew }}"{{ end }} ;;
    *) package_name= ;;
esac
if [ -n "$package_name" ]; then
    if [ "$manager" = brew ] && [ "{{ if hasKey $package "brew_cask" }}{{ $package.brew_cask }}{{ else }}false{{ end }}" = true ]; then
        if ! package_installed brew-cask "$package_name"; then missing_casks="$missing_casks $package_name"; fi
    elif ! package_installed "$manager" "$package_name"; then
        missing="$missing $package_name"
    fi
fi
{{- end }}
{{- end }}
{{- end }}
{{- end }}

if [ -z "$missing" ] && [ -z "$missing_casks" ]; then exit 0; fi

if [ "$manager" = brew ]; then
    [ -z "$missing" ] || brew install $missing
    [ -z "$missing_casks" ] || brew install --cask $missing_casks
    exit 0
fi

if [ "$(id -u)" -eq 0 ]; then
    run_as_root=
elif command -v sudo >/dev/null 2>&1; then
    run_as_root=sudo
else
    printf '%s\n' 'Packages are missing and sudo is unavailable.' >&2
    exit 1
fi

run_privileged() {
    if [ -n "$run_as_root" ]; then "$run_as_root" "$@"; else "$@"; fi
}

case "$manager" in
    apt-get) run_privileged apt-get update; run_privileged apt-get install -y $missing ;;
    dnf) run_privileged dnf install -y $missing ;;
    pacman) run_privileged pacman -S --needed --noconfirm $missing ;;
    zypper) run_privileged zypper --non-interactive install $missing ;;
    apk) run_privileged apk add $missing ;;
esac
