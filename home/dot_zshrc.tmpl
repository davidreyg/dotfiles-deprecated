# Keep Zsh startup non-destructive: application-specific settings live in conf.d.

HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=5000
SAVEHIST=5000
HISTDUP=erase
{{ range .zsh.options }}
setopt {{ . }}
{{- end }}
setopt APPEND_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' 'l:|=* r:|=*' 'r:|=* l:|=*'

if [ -d "$HOME/.local/share/mise/shims" ]; then
    PATH="$HOME/.local/share/mise/shims:$PATH"
fi
if [ -d "$HOME/.local/share/mise/bin" ]; then
    PATH="$HOME/.local/share/mise/bin:$PATH"
fi
export PATH

mise_completion_dir="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions"
if [ -d "$mise_completion_dir" ]; then
    fpath=("$mise_completion_dir" $fpath)
fi

{{ if .zsh.zinit.enabled -}}
zinit_home="{{ .zsh.zinit.home }}"
if [ -r "$zinit_home/zinit.zsh" ]; then
    source "$zinit_home/zinit.zsh"
{{ range .zsh.zinit.plugins }}{{ if .enabled }}
{{ range .ice }}    zinit ice {{ . }}
{{- end }}
    zinit light '{{ .repository }}'
{{- end }}{{- end }}{{ range .zsh.zinit.snippets }}{{ if .enabled }}
{{ range .ice }}    zinit ice {{ . }}
{{- end }}
    zinit snippet '{{ .source }}'
{{- end }}{{- end }}{{ range .zsh.zinit.for }}{{ if .enabled }}
{{ range .ice }}    zinit ice {{ . }}
{{- end }}
    zinit for{{ range .sources }} '{{ . }}'{{ end }}
{{- end }}{{- end }}
fi
{{- end }}

autoload -Uz compinit
compinit

zinit cdreplay -q

for config_file in "${ZDOTDIR:-$HOME}"/.config/zsh/conf.d/*.zsh(N); do
    source "$config_file"
done