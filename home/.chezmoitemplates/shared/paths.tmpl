_path_prefix=
for _path_dir in {{ range .paths.prepend }}"$HOME/{{ . }}" {{ end }}; do
    [ -d "$_path_dir" ] || continue
    case ":$PATH:$_path_prefix:" in
        *":$_path_dir:"*) continue ;;
    esac
    _path_prefix="${_path_prefix:+$_path_prefix:}$_path_dir"
done
[ -z "$_path_prefix" ] || PATH="$_path_prefix:$PATH"
unset _path_prefix _path_dir
export PATH
